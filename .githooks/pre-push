#!/usr/bin/env bash
# pre-push hook — run the same Tier-1 gate CI runs, before the push leaves the machine.
# Mirrors .github/workflows/ci.yml so a red CI is caught locally (the dump_fixtures.py ruff
# nit that reddened CI 3× is exactly what this stops). Tier-2 (@pytest.mark.windows) is the
# VM's job and auto-skips here, so this stays fast (~1s) and host-only.
#
# Enable once per clone:  git config core.hooksPath .githooks
# Bypass for a one-off:    git push --no-verify
set -euo pipefail

echo ">> pre-push: ruff lint"
uv run ruff check .

echo ">> pre-push: ruff format --check"
uv run ruff format --check .

echo ">> pre-push: pytest (Tier 1; windows tests auto-skip)"
uv run pytest -q

echo ">> pre-push: all Tier-1 checks passed"
